{
  "id": "knowledge-store-import-ncert",
  "kind": "cloudrun-job",
  "cloud_run_job": "knowledge-store-import-ncert",
  "image_group": "knowledge-store",
  "verb": "import-ncert",
  "command": ["python"],
  "args": ["-m", "knowledge_store.run", "import-ncert"],
  "cpu": "2",
  "memory": "2Gi",
  "task_timeout": "24h",
  "tasks": 1,
  "parallelism": 1,
  "max_retries": 0,
  "needs_entry_id": false,
  "env_from_target": ["GOOGLE_CLOUD_PROJECT", "GOOGLE_CLOUD_LOCATION"],
  "secrets_via": "runtime-secret-reader",
  "secret_names": ["KNOWLEDGE_STORE_GCS_BUCKET"]
}
