    },
    {
      "id": "whatsapp",
      "kind": "cloudrun",
      "image": "whatsapp",
      "cloud_run": "whatsapp",
      "dockerfile": "whatsapp_adapter/app/Dockerfile",
      "gitlink": "whatsapp_adapter",
      "timeout": "600s",
      "build_timeout": "1200s",
      "min_instances": 1,
      "max_instances": 1,
      "cpu": "1",
      "memory": "512Mi",
      "verify": "health",
      "run_args": [
        "--allow-unauthenticated",
        "--no-cpu-throttling"
