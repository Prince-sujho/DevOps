      "image": "users",
      "cloud_run": "users",
      "dockerfile": "user_service/app/Dockerfile",
      "gitlink": "user_service",
      "timeout": "240s",
      "build_timeout": "1200s",
      "min_instances": 1,
      "max_instances": 10,
      "cpu": "1",
      "memory": "512Mi",
      "verify": "health",
      "run_args": [
        "--allow-unauthenticated",
        "--network=default",
        "--subnet=default",
        "--vpc-egress=all-traffic"
