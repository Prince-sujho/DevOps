      "id": "redirect",
      "pilot": true,
      "kind": "cloudrun",
      "image": "redirect",
      "cloud_run": "redirect",
      "dockerfile": "redirect_service/app/Dockerfile",
      "gitlink": "redirect_service",
      "timeout": "15s",
      "build_timeout": "600s",
      "min_instances": 1,
      "max_instances": 4,
      "cpu": "1",
      "memory": "256Mi",
      "verify": "health",
      "run_args": [
        "--allow-unauthenticated"
      ],
      "included_files": [
        "redirect_service/**",
        "run_redirect.py",
        "ci/redirect-build-deploy.yaml",
        "ci/redirect-deploy-only.yaml",
        "infra/**"
      ]
    },
    {
      "id": "text",
      "kind": "cloudrun",
      "image": "text",
      "cloud_run": "text",
      "dockerfile": "text_agent/app/Dockerfile",
      "gitlink": "text_agent",
      "timeout": "3600s",
      "build_timeout": "3600s",
      "min_instances": 1,
      "max_instances": 10,
      "cpu": "1",
      "memory": "1Gi",
      "verify": "health",
      "run_args": [
        "--allow-unauthenticated"
      ],
      "included_files": [
        "text_agent/**",
        "run_text_agent.py",
        "ci/text-build-deploy.yaml",
        "ci/text-deploy-only.yaml",
        "infra/**"
      ]
    },
    {
