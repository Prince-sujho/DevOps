{
  "region": "asia-south1",
  "registry": "asia-south1-docker.pkg.dev/sujho-dev/services",
  "prod_project": "sujho-478914",
  "dev_project": "sujho-dev",
  "preprod_project": "sujho-preprod",
  "short_sha_len": 7,
  "dc_connection": "sujho-github-dc",
  "dc_connection_prod": "sujho-github-dc-org",
  "kaniko": "gcr.io/kaniko-project/executor@sha256:4e7a52dd1f14872430652bb3b027405b8dfd17c4538751c620ac005741ef9698",
