      "kind": "cloudrun",
      "image": "admin",
      "cloud_run": "admin",
      "dockerfile": "admin/app/Dockerfile",
      "gitlink": "admin",
      "timeout": "240s",
      "build_timeout": "1200s",
      "min_instances": 1,
      "max_instances": 2,
      "cpu": "1",
      "memory": "256Mi",
      "verify": "revision",
      "pre_kaniko": "assets",
      "run_args": [
        "--no-allow-unauthenticated",
        "--ingress=internal-and-cloud-load-balancing",
        "--clear-secrets"
      ],
      "included_files": [
        "admin/**",
        "ci/admin-build-deploy.yaml",
        "ci/admin-deploy-only.yaml",
        "infra/**"
      ]
    }
