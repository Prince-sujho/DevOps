{
  "name": "Sujho Phase 1 — branch naming",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/dependabot/**",
        "refs/heads/chore/phase*",
        "refs/heads/prove/phase1-*"
      ]
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "fb-<person>-<work>-<dd-mm-yy>",
        "negate": false,
        "operator": "regex",
        "pattern": "^fb-[a-z0-9]+-[a-z0-9]+(-[a-z0-9]+)*-(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{2}$"
      }
    }
  ]
}
