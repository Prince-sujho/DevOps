{
  "redirect": {
    "dockerfile": "redirect_service/app/Dockerfile",
    "timeout": "15s",
    "min_instances": "1",
    "max_instances": "4",
    "cpu": "1",
    "memory": "256Mi",
    "verify": "health",
    "run_args": [
      "--allow-unauthenticated"
    ]
  },
  "text": {
    "dockerfile": "text_agent/app/Dockerfile",
    "timeout": "3600s",
    "min_instances": "1",
    "max_instances": "10",
    "cpu": "1",
    "memory": "1Gi",
    "verify": "health",
    "run_args": [
      "--allow-unauthenticated"
    ]
  },
  "users": {
    "dockerfile": "user_service/app/Dockerfile",
    "timeout": "240s",
    "min_instances": "1",
    "max_instances": "10",
    "cpu": "1",
    "memory": "512Mi",
    "verify": "health",
    "run_args": [
      "--allow-unauthenticated",
      "--network=default",
      "--subnet=default",
      "--vpc-egress=all-traffic"
    ]
  },
  "whatsapp": {
    "dockerfile": "whatsapp_adapter/app/Dockerfile",
    "timeout": "600s",
    "min_instances": "1",
    "max_instances": "1",
    "cpu": "1",
    "memory": "512Mi",
    "verify": "health",
    "run_args": [
      "--allow-unauthenticated",
      "--no-cpu-throttling"
    ]
  },
  "document-worker": {
    "dockerfile": "document_worker/Dockerfile",
    "timeout": "3600s",
    "min_instances": "0",
    "max_instances": "10",
    "cpu": "2",
    "memory": "4Gi",
    "verify": "health",
    "run_args": [
      "--allow-unauthenticated",
      "--concurrency=1"
    ]
  },
  "admin": {
    "dockerfile": "admin/app/Dockerfile",
    "timeout": "240s",
    "min_instances": "1",
    "max_instances": "2",
    "cpu": "1",
    "memory": "256Mi",
    "verify": "revision",
    "pre_build_dir": "admin/app",
    "run_args": [
      "--no-allow-unauthenticated",
      "--ingress=internal-and-cloud-load-balancing",
      "--clear-secrets"
    ]
  }
}
