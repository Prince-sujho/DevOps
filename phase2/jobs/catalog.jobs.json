{
  "registry": "asia-south1-docker.pkg.dev/sujho-preprod/services",
  "region": "asia-south1",
  "image_groups": {
    "probe": {
      "image": "probe",
      "dockerfile": "probe/Dockerfile",
      "entry_module": "probe.jobs.job",
      "entry_file": "probe/jobs/job.py",
      "runtime_sa": "jobs-run",
      "cpu": "1",
      "memory": "256Mi",
      "task_timeout": "300s",
      "tasks": 1,
      "parallelism": 1,
      "max_retries": 0
    },
    "knowledge-store": {
      "image": "knowledge-store-jobs",
      "dockerfile": "knowledge_store/Dockerfile",
      "runtime_sa": "knowledge-store-run",
      "cpu": "2",
      "task_timeout": "24h",
      "tasks": 1,
      "parallelism": 1,
      "max_retries": 0
    }
  },
  "jobs": [
    {
      "id": "knowledge-store-ingest",
      "group": "knowledge-store",
      "entry_module": "knowledge_store.jobs.ingest",
      "entry_file": "knowledge_store/jobs/ingest.py",
      "args": [],
      "memory": "4Gi",
      "needs_entry_id": true
    },
    {
      "id": "knowledge-store-remove",
      "group": "knowledge-store",
      "entry_module": "knowledge_store.jobs.remove",
      "entry_file": "knowledge_store/jobs/remove.py",
      "args": [],
      "memory": "2Gi",
      "needs_entry_id": true
    },
    {
      "id": "knowledge-store-sessions",
      "group": "knowledge-store",
      "entry_module": "knowledge_store.jobs.sessions",
      "entry_file": "knowledge_store/jobs/sessions.py",
      "args": [],
      "memory": "2Gi",
      "schedule": "0 * * * *"
    },
    {
      "id": "knowledge-store-import-ncert",
      "group": "knowledge-store",
      "entry_module": "knowledge_store.jobs.import_ncert",
      "entry_file": "knowledge_store/jobs/import_ncert.py",
      "args": [],
      "memory": "2Gi"
    },
    {
      "id": "knowledge-store-import-educart",
      "group": "knowledge-store",
      "entry_module": "knowledge_store.jobs.import_educart",
      "entry_file": "knowledge_store/jobs/import_educart.py",
      "args": [],
      "memory": "2Gi"
    },
    {
      "id": "probe-job",
      "group": "probe",
      "args": [],
      "schedule": "0 * * * *",
      "env": [],
      "overrides": {
        "prod": {
          "env": ["PROBE_CHECKS=on"]
        }
      }
    }
  ]
}
