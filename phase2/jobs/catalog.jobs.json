{
  "registry": "asia-south1-docker.pkg.dev/sujho-preprod/services",
  "region": "asia-south1",
  "image_groups": {
    "probe": {
      "image": "probe",
      "dockerfile": "probe/Dockerfile",
      "runtime_sa": "jobs-run",
      "cpu": "1",
      "memory": "256Mi",
      "task_timeout": "300s",
      "tasks": 1,
      "parallelism": 1,
      "max_retries": 0
    },
    "knowledge-store": {
      "image": "knowledge-store-jobs",
      "dockerfile": "knowledge_store/Dockerfile",
      "runtime_sa": "knowledge-store-run",
      "cpu": "2",
      "task_timeout": "24h",
      "tasks": 1,
      "parallelism": 1,
      "max_retries": 0
    }
  },
  "jobs": [
    {
      "id": "knowledge-store-ingest",
      "memory": "4Gi",
      "needs_entry_id": true
    },
    {
      "id": "knowledge-store-remove",
      "memory": "2Gi",
      "needs_entry_id": true
    },
    {
      "id": "knowledge-store-sessions",
      "memory": "2Gi",
      "schedule": "0 * * * *"
    },
    {
      "id": "knowledge-store-import-ncert",
      "memory": "2Gi"
    },
    {
      "id": "knowledge-store-import-educart",
      "memory": "2Gi"
    },
    {
      "id": "probe-job",
      "schedule": "0 * * * *"
    }
  ]
}
